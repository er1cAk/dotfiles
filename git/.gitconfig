[user]
	name = Erik Dvorčák
	email = erik.dvorcak@gmail.com
[core]
	autocrlf = input
	pager = diff-so-fancy | less --tabs=4 -RFX
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = false
[rebase]
	autoSquash = true
[interactive]
	diffFilter = diff-so-fancy --patch
[color]
	ui = true
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "diff"]
	meta = 11
	frag = magenta bold
	func = 146 bold
	commit = yellow bold
	old = red bold
	new = green bold
	whitespace = red reverse

# Machine-specific settings (credential helpers, hooksPath, GPG signing, which
# only works where the key and gpg are installed) live in this untracked file.
# Included before the work identity, so inside ~/work the work identity wins.
[include]
	path = ~/.gitconfig.local

# Per-machine / per-context identity. Work repos under ~/work use a separate
# identity file that is NOT tracked in this repo (it holds a work address).
# git silently ignores this block if the file does not exist.
#
# gitdir/i, not gitdir: macOS paths are case-insensitive but gitdir: matching
# is not, so a ~/Work directory would silently fall back to the personal identity.
[includeIf "gitdir/i:~/work/"]
	path = ~/.gitconfig-work
